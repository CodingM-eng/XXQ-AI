# Firebase project id (same as projectId in public/firebase-config.js). Used to verify ID tokens.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Protected super administrator (default shown)
SUPER_ADMIN_EMAIL=codingdevelopia@gmail.com
# Development-only invitations, comma separated. Real invitations will live in PostgreSQL.
XXQ_INVITES=
PORT=3000
HOST=127.0.0.1
# Use "false" only for plain-http local development
XXQ_COOKIE_SECURE=false
# Emergency recovery for the super administrator; keep unset/false in production
XXQ_ENABLE_RECOVERY=false
